    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.1.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Ollama" Version="9.7.0-preview.1.25356.2" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.0.0-preview.1.25559.3" />

    <!-- Microsoft ASP.NET Core Packages -->
