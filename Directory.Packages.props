<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire Packages -->
    <PackageVersion Include="Aspire.Azure.AI.Inference" Version="13.0.2-preview.1.25603.5" />
