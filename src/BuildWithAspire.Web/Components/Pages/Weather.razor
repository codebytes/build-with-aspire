@page "/weather"
@using BuildWithAspire.Web.Clients
@attribute [StreamRendering]
@attribute [OutputCache(Duration = 5)]

@inject WeatherApiClient WeatherApi

<PageTitle>Weather</PageTitle>

<h1>Weather Forecast</h1>

<p>This component demonstrates weather data loaded from the MCP (Model Context Protocol) weather tools via the backend API service.</p>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading weather data...</span>
        </div>
        <span class="ms-3">Loading weather data from MCP tools...</span>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning" role="alert">
        <h5>⚠️ Weather Service Notice</h5>
        <p>@errorMessage</p>
        <button class="btn btn-outline-primary btn-sm" @onclick="RefreshWeather">
            <i class="bi bi-arrow-clockwise"></i> Try Again
        </button>
    </div>
}
else if (forecasts == null || forecasts.Length == 0)
{
    <div class="alert alert-info" role="alert">
        <h5>No Weather Data Available</h5>
        <p>Unable to retrieve weather forecast data.</p>
        <button class="btn btn-primary btn-sm" @onclick="RefreshWeather">
            <i class="bi bi-cloud-sun"></i> Load Weather Data
        </button>
    </div>
}
else
{
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="alert alert-success" role="alert">
                <strong>✅ MCP Tools Active:</strong> Weather data loaded via Model Context Protocol
            </div>
        </div>
        <div class="col-md-6 text-end">
            <button class="btn btn-outline-secondary btn-sm" @onclick="RefreshWeather" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th scope="col">📅 Date</th>
                    <th scope="col">🌡️ Celsius</th>
                    <th scope="col">🌡️ Fahrenheit</th>
                    <th scope="col">☀️ Conditions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var forecast in forecasts)
                {
                    <tr>
                        <td>@forecast.Date.ToShortDateString()</td>
                        <td>
                            <span class="badge @GetTemperatureBadgeClass(forecast.TemperatureC)">
                                @forecast.TemperatureC°C
                            </span>
                        </td>
                        <td>@forecast.TemperatureF°F</td>
                        <td>
                            <span class="fw-semibold">@forecast.Summary</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3 text-muted small">
        <i class="bi bi-info-circle"></i>
        Weather data is generated by MCP (Model Context Protocol) tools running in the backend service.
        Data refreshes every 5 minutes via output caching.
    </div>
}

@code {
    private WeatherForecast[]? forecasts;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadWeatherData();
    }

    private async Task LoadWeatherData()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            forecasts = await WeatherApi.GetWeatherAsync(maxItems: 7);
            
            if (forecasts == null || forecasts.Length == 0)
            {
                errorMessage = "The MCP weather service returned no data. The service may be starting up or temporarily unavailable.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load weather data: {ex.Message}. Please check that the MCP server is running.";
            forecasts = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RefreshWeather()
    {
        await LoadWeatherData();
    }

    private string GetTemperatureBadgeClass(int temperatureC)
    {
        if (temperatureC < 0) return "bg-primary text-white";    // Freezing - blue
        if (temperatureC < 10) return "bg-info text-white";      // Cold - light blue  
        if (temperatureC < 20) return "bg-secondary text-white"; // Cool - gray
        if (temperatureC < 30) return "bg-warning text-dark";    // Warm - yellow
        return "bg-danger text-white";                           // Hot - red
    }
}
