@page "/chat"
@page "/chat/{ConversationId:guid}"
@using BuildWithAspire.Web.Clients
@using BuildWithAspire.Web.Models
@using Markdig
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject ILogger<Chat> Logger
@inject NavigationManager Navigation
@inject ConversationApiClient ConversationApiClient

<PageTitle>Chat with History</PageTitle>


<div class="chat-container">
    <div class="conversations-sidebar">
        <div class="sidebar-header">
            <h3>Conversations</h3>
            <button class="btn btn-primary btn-sm" @onclick="ShowNewConversationDialog">New Chat</button>
        </div>
        
        <div class="conversations-list">
            @if (_conversations == null)
            {
                <p>Loading conversations...</p>
            }
            else if (_conversations.Count == 0)
            {
                <p>No conversations yet. Start a new chat!</p>
            }
            else
            {
                @foreach (var conv in _conversations)
                {
                    <div class="conversation-item @(conv.Id == ConversationId ? "active" : "")"
                         @onclick="@(() => SelectConversation(conv.Id))"
                         style="cursor: pointer;">
                        <div class="conversation-name">@conv.Name</div>
                        <div class="conversation-meta">
                            <small>@conv.MessageCount messages · @conv.UpdatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</small>
                        </div>
                        <button class="btn-delete" @onclick:stopPropagation="true" @onclick="() => DeleteConversation(conv.Id)">🗑️</button>
                    </div>
                }
            }
        </div>
    </div>

    <div class="chat-main">
        @if (ConversationId == null)
        {
            <div class="no-conversation">
                <h2>Welcome to Chat with History!</h2>
                <p>Select a conversation from the sidebar or create a new one to get started.</p>
            </div>
        }
        else
        {
            <h1>@_currentConversationName</h1>
            
            <div id="scrollbox" @ref="_scrollBoxRef">
                @if (_messages == null)
                {
                    <p>Loading messages...</p>
                }
                else if (_messages.Count == 0)
                {
                    <div style="text-align: center; color: #6c757d; padding: 2rem;">
                        <p>No messages yet. Start the conversation!</p>
                    </div>
                }
                else
                {
                    foreach (var item in _messages)
                    {
                        <div class="@GetMessageCss(item.Role)" data-message-id="@item.Id">
                            <div class="user">@item.Role</div>
                            <div class="msg">
                                @if (item.Role == "assistant")
                                {
                                    @((MarkupString)Markdown.ToHtml(item.Content))
                                }
                                else
                                {
                                    @item.Content
                                }
                            </div>
                            <div class="timestamp">@item.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                        </div>
                    }
                }
                
                @if (_isProcessing)
                {
                    <div class="received">
                        <div class="user">assistant</div>
                        <div class="msg">
                            <div class="thinking-indicator">
                                <span class="thinking-dots">⠋</span> Thinking...
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="chat-input">
                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="error-message">
                        <span class="error-icon">⚠️</span> @_errorMessage
                        <button class="error-dismiss" @onclick="() => _errorMessage = string.Empty">×</button>
                    </div>
                }
                <div class="input-container">
                    <input @ref="_inputRef" 
                           class="form-control" 
                           placeholder="Type your message..." 
                           @bind="_newMessage" 
                           @onkeydown="OnKeyDown" 
                           disabled="@_isProcessing" />
                    <button type="button" 
                            class="btn btn-primary" 
                            @onclick="SendMessageAsync" 
                            disabled="@(_isProcessing || string.IsNullOrWhiteSpace(_newMessage))">
                        @if (_isProcessing)
                        {
                            <span class="spinner">⠋</span>
                        }
                        else
                        {
                            <span>Send</span>
                        }
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (_showNewConversationDialog)
{
    <div class="modal-backdrop">
        <div class="modal-content">
            <h3>New Conversation</h3>
            <input class="form-control" placeholder="Conversation name" @bind="_newConversationName" />
            <div class="modal-buttons">
                <button class="btn btn-secondary" @onclick="() => _showNewConversationDialog = false">Cancel</button>
                <button class="btn btn-primary" @onclick="CreateNewConversation" disabled="@string.IsNullOrWhiteSpace(_newConversationName)">Create</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid? ConversationId { get; set; }

    // State
    private List<ConversationSummary>? _conversations;
    private List<BuildWithAspire.Web.Models.Message> _messages = new();
    private string _currentConversationName = string.Empty;
    private string _newMessage = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isProcessing;
    private bool _showNewConversationDialog;
    private string _newConversationName = string.Empty;
    private bool _isInitialized;
    private Guid? _lastLoadedConversationId;
    
    // UI References
    private ElementReference _scrollBoxRef;
    private ElementReference _inputRef;
    private bool _shouldScrollToBottom;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadConversationsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error during chat component initialization");
            _conversations = new List<ConversationSummary>();
            SetError("Failed to load conversations. Please refresh the page.");
        }
        finally
        {
            _isInitialized = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_isInitialized && ConversationId != _lastLoadedConversationId)
        {
            await LoadConversationAsync();
        }
    }




    private async Task LoadConversationAsync()
    {
        ClearError();
        
        if (!ConversationId.HasValue || ConversationId.Value == Guid.Empty)
        {
            _messages.Clear();
            _currentConversationName = string.Empty;
            _lastLoadedConversationId = null;
            return;
        }
        
        if (_lastLoadedConversationId == ConversationId)
        {
            return; // Already loaded
        }
        
        Logger.LogInformation("Loading conversation {ConversationId}", ConversationId);
        
        try
        {
            var conversation = await ConversationApiClient.GetConversationAsync(ConversationId.Value);
            
            if (conversation != null)
            {
                _messages = conversation.Messages?.OrderBy(m => m.CreatedAt).ToList() ?? new List<BuildWithAspire.Web.Models.Message>();
                _currentConversationName = conversation.Name;
                _lastLoadedConversationId = ConversationId;
                _shouldScrollToBottom = true;
                
                Logger.LogInformation("Loaded conversation {ConversationId} with {MessageCount} messages", 
                    ConversationId, _messages.Count);
            }
            else
            {
                Logger.LogWarning("Conversation {ConversationId} not found", ConversationId);
                _messages.Clear();
                _currentConversationName = "Conversation Not Found";
                SetError("Conversation not found.");
            }
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("404"))
        {
            Logger.LogWarning("Conversation {ConversationId} returned 404", ConversationId);
            _messages.Clear();
            _currentConversationName = "Conversation Not Found";
            SetError("Conversation not found.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading conversation {ConversationId}", ConversationId);
            _messages.Clear();
            _currentConversationName = "Error Loading Conversation";
            SetError("Failed to load conversation. Please try again.");
        }
        
        StateHasChanged();
    }


    private async Task LoadConversationsAsync()
    {
        try
        {
            _conversations = await ConversationApiClient.GetConversationsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading conversations list");
            _conversations = new List<ConversationSummary>();
            SetError("Failed to load conversations.");
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !_isProcessing && !string.IsNullOrWhiteSpace(_newMessage))
        {
            await SendMessageAsync();
        }
    }

    private async Task SendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(_newMessage) || !ConversationId.HasValue || _isProcessing)
        {
            return;
        }

        var messageText = _newMessage.Trim();
        _newMessage = string.Empty;
        _isProcessing = true;
        ClearError();
        
        // Add user message optimistically
        var userMessage = new BuildWithAspire.Web.Models.Message
        {
            Id = Guid.NewGuid(),
            ConversationId = ConversationId.Value,
            Role = "user",
            Content = messageText,
            CreatedAt = DateTime.UtcNow
        };
        
        _messages.Add(userMessage);
        _shouldScrollToBottom = true;
        StateHasChanged();

        Logger.LogInformation("Sending message to conversation {ConversationId}", ConversationId);

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(10));
            var response = await ConversationApiClient.SendMessageAsync(ConversationId.Value, messageText, cts.Token);
            
            // Add assistant response
            var assistantMessage = new BuildWithAspire.Web.Models.Message
            {
                Id = Guid.NewGuid(),
                ConversationId = ConversationId.Value,
                Role = "assistant",
                Content = response.Response ?? "No response received.",
                CreatedAt = DateTime.UtcNow
            };
            
            _messages.Add(assistantMessage);
            _shouldScrollToBottom = true;
            
            Logger.LogInformation("Message sent successfully to conversation {ConversationId}", ConversationId);
            
            // Refresh conversations list to update message counts
            _ = Task.Run(LoadConversationsAsync);
        }
        catch (OperationCanceledException)
        {
            Logger.LogWarning("Message sending timed out for conversation {ConversationId}", ConversationId);
            SetError("Request timed out. Please try again.");
            
            // Remove the optimistically added user message
            _messages.Remove(userMessage);
            _newMessage = messageText; // Restore message
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error sending message to conversation {ConversationId}", ConversationId);
            SetError("Failed to send message. Please try again.");
            
            // Remove the optimistically added user message
            _messages.Remove(userMessage);
            _newMessage = messageText; // Restore message
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
            
            // Focus input
            try
            {
                await _inputRef.FocusAsync();
            }
            catch
            {
                // Ignore focus errors
            }
        }
    }

    private void ShowNewConversationDialog()
    {
        _newConversationName = $"Chat {DateTime.Now:MMM dd, HH:mm}";
        _showNewConversationDialog = true;
    }

    private async Task CreateNewConversation()
    {
        if (string.IsNullOrWhiteSpace(_newConversationName))
        {
            return;
        }

        try
        {
            var conversation = await ConversationApiClient.CreateConversationAsync(_newConversationName.Trim());
            _showNewConversationDialog = false;
            _newConversationName = string.Empty;
            await LoadConversationsAsync();
            Navigation.NavigateTo($"/chat/{conversation.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error creating conversation {ConversationName}", _newConversationName);
            SetError("Failed to create conversation. Please try again.");
        }
    }

    private void SelectConversation(Guid id)
    {
        Navigation.NavigateTo($"/chat/{id}");
    }

    private async Task DeleteConversation(Guid id)
    {
        try
        {
            await ConversationApiClient.DeleteConversationAsync(id);
            await LoadConversationsAsync();
            if (ConversationId == id)
            {
                Navigation.NavigateTo("/chat");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting conversation {ConversationId}", id);
            SetError("Failed to delete conversation. Please try again.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldScrollToBottom)
        {
            _shouldScrollToBottom = false;
            await JS.InvokeVoidAsync("scrollToBottom", _scrollBoxRef);
        }
    }

    private string GetMessageCss(string role)
    {
        return role.ToLower() == "user" ? "sent" : "received";
    }
    
    private void SetError(string message)
    {
        _errorMessage = message;
        StateHasChanged();
    }
    
    private void ClearError()
    {
        _errorMessage = string.Empty;
    }


}

<style>
    .chat-container {
        display: flex;
        height: calc(100vh - 100px);
        gap: 1rem;
    }

    .conversations-sidebar {
        width: 300px;
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 1rem;
        overflow-y: auto;
    }

    .sidebar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #dee2e6;
    }

    .sidebar-header h3 {
        margin: 0;
    }

    .conversation-item {
        display: block;
        padding: 0.75rem;
        margin-bottom: 0.5rem;
        background-color: white;
        border-radius: 6px;
        cursor: pointer;
        position: relative;
        transition: all 0.2s;
    }

    .conversation-item:hover {
        background-color: #e9ecef;
    }

    .conversation-item.active {
        background-color: #0d6efd;
        color: white;
    }

    .conversation-name {
        font-weight: 500;
        margin-bottom: 0.25rem;
    }

    .conversation-meta {
        font-size: 0.875rem;
        opacity: 0.7;
    }

    .btn-delete {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        opacity: 0.7;
        transition: opacity 0.2s;
    }

    .btn-delete:hover {
        opacity: 1;
    }

    .chat-main {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .no-conversation {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        text-align: center;
        color: #6c757d;
    }

    #scrollbox {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        background-color: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 1rem;
    }

    .chat-input {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .input-container {
        display: flex;
        gap: 0.5rem;
    }

    .input-container input {
        flex: 1;
    }

    .error-message {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem;
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
        border-radius: 4px;
        font-size: 0.875rem;
    }

    .error-icon {
        font-size: 1rem;
    }

    .error-dismiss {
        margin-left: auto;
        background: none;
        border: none;
        font-size: 1.2rem;
        cursor: pointer;
        color: #721c24;
        opacity: 0.7;
    }

    .error-dismiss:hover {
        opacity: 1;
    }

    .thinking-indicator {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .thinking-dots {
        animation: spin 1s linear infinite;
    }

    .spinner {
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .chat-container .sent, 
    .chat-container .received {
        margin-bottom: 1rem;
        padding: 0.75rem;
        border-radius: 8px;
        position: relative;
        clear: both;
        top: auto !important;
        text-align: left !important;
    }

    .chat-container .sent {
        background-color: #0d6efd !important;
        color: white !important;
        margin-left: 25% !important;
        margin-right: 1rem !important;
        float: right;
    }

    .chat-container .received {
        background-color: white !important;
        color: black !important;
        margin-right: 25% !important;
        margin-left: 1rem !important;
        border: 1px solid #dee2e6 !important;
        float: left;
    }

    .chat-container .sent:after,
    .chat-container .received:after {
        display: none !important;
    }

    .chat-container .user {
        font-weight: bold !important;
        margin-bottom: 0.25rem;
        font-size: 0.875rem !important;
        color: inherit !important;
    }

    .chat-container .msg {
        display: block;
        word-wrap: break-word;
    }

    .chat-container .timestamp {
        font-size: 0.75rem;
        opacity: 0.7;
        margin-top: 0.25rem;
    }

    .modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background-color: white;
        padding: 2rem;
        border-radius: 8px;
        width: 400px;
    }

    .modal-content h3 {
        margin-top: 0;
    }

    .modal-content input {
        width: 100%;
        margin: 1rem 0;
    }

    .modal-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: flex-end;
    }
</style>

<script>
    window.scrollToBottom = (element) => {
        if (element) {
            element.scrollTop = element.scrollHeight;
        }
    };
</script>
